# Telegram Bot Sozlamalari
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Superadmin Telegram ID raqamlari (vergul bilan ajratilgan)
SUPERADMIN_IDS=1685356708,987654321

# Ma'lumotlar bazasi URL (Lokal SQLite yoki Supabase / PostgreSQL)
# SQLite uchun: sqlite+aiosqlite:///./data/elonbot.db
# PostgreSQL uchun: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/elonbot.db

# Asosiy e'lonlar chiqadigan Telegram kanal ID yoki @username (masalan: @freelance_uzb yoki -1001234567890)
DEFAULT_CHANNEL_ID=@freelance_uzb

# Suv belgisi / Kanal brendi
WATERMARK_TEXT=@freelance_uzb
